      DTS:Namespace="User"
      DTS:ObjectName="query">
      <DTS:VariableValue
        DTS:DataType="8">SELECT        ID, SRV, ServerIP 
FROM            [dbo].[MDParking] 
WHERE        (type = 'MY') AND (Frecuency = 'N')</DTS:VariableValue>
