      DTS:Expression="&quot;SELECT        ID, SRV, ServerIP &#xA;FROM            [dbo].[MDParking] &#xA;WHERE        (type = 'MY') AND (Frecuency = '&quot;  + @[$Package::Frecuency]  + &quot;')&quot;"
